# required for all tests
PORTKEY_API_KEY=your-api-key
TEST_WORKSPACE_ID=your-workspace-uuid
TEST_WORKSPACE_SLUG=ws-your-workspace-slug

# For Prompt tests (optional - tests will skip if not set)
TEST_COLLECTION_ID=your-collection-uuid
TEST_VIRTUAL_KEY=your-virtual-key-uuid-or-slug

# For Provider/Virtual Key tests (optional - tests will skip if not set)
TEST_INTEGRATION_ID=your-integration-slug

# For SCIM tests (optional - tests will skip if not set)
TEST_SCIM_GROUP_ID=your-scim-group-id

# Opt-in gates for organisation-scoped tests. Both are unset by default, and the
# tests behind them skip rather than fail, so a key without the scopes below (or
# an organisation you don't want mutated) still gets a green run.
#
# Creates organisation-scoped guardrails. The key needs the
# organisation_guardrails.create / .read / .update / .delete scopes, which are
# separate from the workspace-scoped guardrails.* family — so a key that passes
# every other guardrail test can still 403 here.
# PORTKEY_TEST_ORG_GUARDRAILS=1
#
# Overwrites the organisation's real default guardrails, which is shared state
# with no per-test isolation: destroy clears both lists. Only set this against an
# organisation you are happy to mutate. The key needs
# organisation_settings.read / .update, plus the guardrail scopes above.
# PORTKEY_TEST_ORG_DEFAULTS=1
